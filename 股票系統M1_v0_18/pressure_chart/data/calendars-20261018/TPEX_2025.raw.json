{"data":{"html":"<table class=\"page-table\">\r\n    <tr>\r\n        <td class=\"page-table-body-center\" >中華民國114年有價證券櫃檯買賣市場開（休）市日期表<\u002ftd>\r\n    <\u002ftr>\r\n<\u002ftable>\r\n<table class=\"page-table\">\r\n    <tr>\r\n        <th width=\"34%\" nowrap bgcolor=\"#EDEDED\" class=\"page-table-head-center\">紀念節日名稱<\u002fth>\r\n        <th width=\"5%\" nowrap bgcolor=\"#EDEDED\" class=\"page-table-head-center\">日期<\u002fth>\r\n        <th width=\"5%\" nowrap bgcolor=\"#EDEDED\" class=\"page-table-head-center\">星期<\u002fth>\r\n        <th nowrap bgcolor=\"#EDEDED\" class=\"page-table-head-center\">說明<\u002fth>\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">中華民國開國紀念日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">1月1日<\u002ftd>\t\t\r\n        <td nowrap class=\"page-table-body-center\">三<\u002ftd>\r\n        <td class=\"page-table-body-left\">依規定放假1日。<\u002ftd>\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">國曆新年開始交易日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">1月2日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">四<\u002ftd>\r\n        <td class=\"page-table-body-left\">國曆新年開始交易。<\u002ftd>\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">農曆春節前<strong>國際債券交易系統<\u002fstrong>最後交易日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">1月21日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">二<\u002ftd>\r\n        <td class=\"page-table-body-left\">1月22日、1月23日及1月24日市場無交易，僅辦理給付結算。<\u002ftd>\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">農曆春節前<strong>股票交易系統<\u002fstrong>最後交易日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\" rowspan=\"2\">1月22日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\" rowspan=\"2\">三<\u002ftd>\r\n        <td class=\"page-table-body-left\" rowspan=\"2\">1月23日及1月24日市場無交易，僅辦理給付結算。<\u002ftd>\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">農曆春節前<strong>債券等殖成交系統（含比對系統）<\u002fstrong>最後交易日<\u002ftd>\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">農曆春節前<strong>債券處所議價<\u002fstrong>最後交易日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">1月24日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">五<\u002ftd>\r\n        <td class=\"page-table-body-left\">&nbsp;<\u002ftd>\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">農曆除夕前一日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">1月27日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">一<\u002ftd>\r\n        <td class=\"page-table-body-left\">1月27日（星期一）調整放假，於2月8日（星期六）補行上班，但不交易亦不交割。<\u002ftd>\r\n    <\u002ftr>\t\r\n    <tr>\r\n        <td class=\"page-table-body-left\">農曆除夕<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">1月28日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">二<\u002ftd>\r\n        <td class=\"page-table-body-left\">依規定放假1日。<\u002ftd>\r\n    <\u002ftr>    \r\n    <tr>\r\n        <td class=\"page-table-body-left\">農曆春節<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">\r\n            1月29日<br />\r\n            1月30日<br />\r\n            1月31日<br />\r\n        <\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">\r\n            三<br />\r\n            四<br />\r\n            五<br />\r\n        <\u002ftd>\r\n        <td class=\"page-table-body-left\">依規定於1月29日至1月31日放假3日。<\u002ftd>\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">農曆春節後開始交易日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">2月3日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">一<\u002ftd>\r\n        <td class=\"page-table-body-left\">農曆春節後開始交易。<\u002ftd>\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">和平紀念日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">2月28日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">五<\u002ftd>\r\n        <td class=\"page-table-body-left\">依規定放假1日。<\u002ftd>\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">兒童節及民族掃墓節<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">          \r\n            4月3日<br />\r\n            4月4日<br />\r\n        <\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">\r\n            四<br />\r\n            五<br />\r\n        <\u002ftd>\r\n        <td class=\"page-table-body-left\">\r\n            兒童節與民族掃墓節為4月4日同一日，依規定於前一日放假。<br />\r\n            依規定放假1日。<br />\r\n        <\u002ftd>\r\n    <\u002ftr>\t\t\r\n    <tr>\r\n        <td class=\"page-table-body-left\">勞動節<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">5月1日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">四<\u002ftd>\r\n        <td class=\"page-table-body-left\">依規定放假1日。<\u002ftd>\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">端午節<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">\r\n            5月30日<br />\r\n            5月31日<br />\r\n        <\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">\r\n            五<br />\r\n            六<br />\r\n        <\u002ftd>\r\n        <td class=\"page-table-body-left\">\r\n            端午節5月31日適逢星期六，依規定於前一日補假。<br />\r\n            依規定放假1日。\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">孔子誕辰紀念日/教師節<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">\r\n            9月28日<br />\r\n            9月29日<br />\r\n            <br />\r\n        <\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">\r\n            日<br />\r\n            一<br />\r\n            <br />\r\n        <\u002ftd>\r\n        <td class=\"page-table-body-left\">\r\n            依規定放假1日。<br />\r\n            孔子誕辰紀念日/教師節9月28日適逢星期日，依規定於次一日補假。\r\n        <\u002ftd>\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">中秋節<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">10月6日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">一<\u002ftd>\r\n        <td class=\"page-table-body-left\">依規定放假1日。<\u002ftd>\r\n    <\u002ftr>\r\n    <tr>\r\n        <td class=\"page-table-body-left\">國慶日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">10月10日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">五<\u002ftd>\r\n        <td class=\"page-table-body-left\">依規定放假1日。<\u002ftd>\r\n    <\u002ftr>    \r\n    <tr>\r\n        <td class=\"page-table-body-left\">臺灣光復暨金門古寧頭大捷紀念日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">\r\n            10月24日<br />\r\n            <br />\r\n            10月25日\r\n        <\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">\r\n            五<br />\r\n            <br />\r\n            六\r\n        <\u002ftd>\r\n        <td class=\"page-table-body-left\">\r\n            臺灣光復暨金門古寧頭大捷紀念日10月25日適逢星期六，依規定於前一日補假。<br />\r\n            依規定放假1日。\r\n        <\u002ftd>\r\n    <\u002ftr>    \r\n    <tr>\r\n        <td class=\"page-table-body-left\">行憲紀念日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">12月25日<\u002ftd>\r\n        <td nowrap class=\"page-table-body-center\">四<\u002ftd>\r\n        <td class=\"page-table-body-left\">依規定放假1日。<\u002ftd>\r\n    <\u002ftr>    \r\n<\u002ftable>\r\n"},"endDate":"20260101","stat":"ok"}