                        <img class="newsImg" src="https://www.esunbank.com/zh-tw/-/media/ESUNBANK/Images/Home/About/news/260907.jpg?h=1237&amp;w=2000&amp;hash=7EB19979C25AD6FA25667B6C64066E91" alt="新聞圖片">
                    </a>
                    <div class="content">
                        <p class="catalog mt-md-3" news-more-catalogs data-val="{C9225015-50BD-40E4-A15A-199F3D8ADE17}|{3EAECBA0-5505-4285-B6FC-DD75EE88B2B4}">
                            <span>2026/09/07</span>
                        </p>
                        <div class="contentBox">
