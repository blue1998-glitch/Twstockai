<script nonce="Eh/o9vrzbqOydcJWqQaz5A==">
    (function (catalogElements, dicCategory, ignoreDicCategory) {
        var url = "/zh-tw/news-center/news-center/news";
        // 初始化各篇新聞分類
        function initCategories(catalogElements){
            for (var i = 0; i < catalogElements.length; i++) {
                (function (index) {
                    if (catalogElements[index]) {
                        let json = catalogElements[index].getAttribute('data-val');
                        let categories = getAttribute(json.split('|'));
                        catalogElements[index].innerHTML += '&nbsp;' + categories.join('/');
                    }
                })(i);
            }
        }

        function getAttribute(categories) {

            let arry = [];
            for (var i = 0; i < categories.length; i++) {
                var ctegory = categories[i];

                if (ignoreDicCategory) {
                    let gnore = ignoreDicCategory[ctegory];
                    if (gnore) {
                        continue;
                    }
                }
                if (dicCategory[ctegory]) {
                    arry.push('<a href="' + url + '?' + 'category' + '=' + dicCategory[ctegory].Item2 + '" data-val="' + ctegory + '" target="_blank rel="noopener noreferrer"">' + dicCategory[ctegory].Item1 + '</a>');
                }
            }
            return arry;
        }
                
        // 初始化各篇新聞分類
        initCategories(catalogElements);

    })(document.querySelectorAll('[news-more-catalogs]'), newsMoreDicCategory, newsMoreIgnoreDicCategory);
</script>
