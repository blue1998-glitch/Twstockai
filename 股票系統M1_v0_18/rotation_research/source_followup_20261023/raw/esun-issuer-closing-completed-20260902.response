    <script nonce="Eh/o9vrzbqOydcJWqQaz5A==">
        (function (smBtn, h1, newsCatalog, dicCategory, ignoreDicCategory, ItemAttribute) {
            var url = "/zh-tw/news-center/news-center/news";
            // 按鈕綁定事件
            function goBack() {
                if (window.history.length > 1 && document.referrer && document.referrer.indexOf(this.href) != -1 &&
                    new URL(document.referrer).pathname != location.pathname) {
                    event.preventDefault();
                    history.back();
                    return false;
                }
            }
            smBtn.addEventListener("click", goBack);

            // <title>帶入【News Title】
            const title = document.title;
            document.title = h1.innerText + title;

            if (dicCategory) {
                let categories = getCategory(dicCategory);
                newsCatalog.innerHTML += categories.join('/');
            }

            function getCategory(data) {

                let arry = [];
                Object.keys(data).forEach(function (key) {

                    if (ignoreDicCategory) {
                        let gnore = ignoreDicCategory[key];
                        if (gnore) {
                            return;
                        }
                    }
                    
                    if (ItemAttribute.includes(key)) {
                        if (data[key]) {
                            arry.push('<a href="' + url + '?' + 'category' + '=' + data[key].Item2 + '" data-val="' + key + '" target="_blank rel="noopener noreferrer"">' + data[key].Item1 + '</a>');
                        }
                    }
                })

                return arry;
            }

        })(document.querySelector('[news-gobak]'), document.getElementById('news-title'), document.getElementById('news-catalog'), newsCenterDicCategory, newsCenterIgnoreDicCategory, newsItemAttribute);
    </script>

</body>
</html>
